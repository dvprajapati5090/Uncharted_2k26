NODE_ENV=development
PORT=3000

# MongoDB Atlas authoritative connection
MONGODB_URI=
MONGODB_DB_NAME=synapsemem
MONGODB_MEMORIES_COLLECTION=memories
MONGODB_MEMORY_EVENTS_COLLECTION=memory_events
MONGODB_VECTOR_INDEX_NAME=memory_vector_index

# Embedding Provider (voyage | mock-deterministic)
# Use 'voyage' with VOYAGE_API_KEY for real Atlas Vector Search (1024D)
# Default fallback 'mock-deterministic' produces valid 1024D vectors for testing/offline without failing
EMBEDDING_PROVIDER=mock-deterministic
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4
VOYAGE_EMBEDDING_DIMENSIONS=1024

# LLM Provider for Extraction & Grounded Generation (openai | gemini | anthropic | local-heuristic)
LLM_PROVIDER=local-heuristic
LLM_API_KEY=
LLM_MODEL=

# Demo & Time Machine
SESSION_SECRET=synapsemem-hackathon-secret-key-2026
APP_TIME_OVERRIDE=
DEMO_MODE=true
